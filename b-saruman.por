programa {
  funcao inicio() {
    //Sarumano usa 7 bombas de fumaça por show, precisamos saber quantas bombas ele usaria em um total de determinados shows
    real show 
    inteiro bomb
    escreva("Saruman, quantos shows o senhor tem agendado no condado?")
    leia(show)
    bomb=show*7
    escreva("Voce tera de usar um total de: " + bomb ) escreva(" smokes neste show de horreres orcs")
  
  }
}
