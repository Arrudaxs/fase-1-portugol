programa {
  funcao inicio() {
    cadeia senha

    escreva("Olá gostaria ver de qual piloto ? ")
    leia(senha)

    se(senha == "brad pit"){
      escreva("Voce tem mais 200 Creditos na Tag Heuer Custom Experience!!")
    }
    se(senha != "brad pit"){
      escreva("Muito boa escolha! agora queremos seu CPF para voce comprar seus pontos na Tag Heuer Custom Experience ")
    }
  }
}
