programa {
  funcao inicio() {
    inteiro dia

    
  
  escreva("comeco de mes num domingo e tem feriado! que tal aproveritarmos com a familia no dia: ")
  leia(dia)

  se(dia == 1){
    escreva("voces vao sair domingo")
  }
  se(dia == 2){
    escreva("voces irão sair segunda")
  }
  se(dia == 3){
    escreva("voces irão sair terça")
  }
  se(dia == 4){
    escreva("voces irão sair quarta")
  }
  se(dia == 5){
    escreva("voces irão sair na quinta")
  }
  se(dia == 6){
    escreva("voces irão sair na sexta")
  }
  se(dia == 7)
  escreva("voces irão sair no sabado")

  
  }
}
